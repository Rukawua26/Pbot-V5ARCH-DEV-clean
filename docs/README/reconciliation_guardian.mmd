flowchart TD
    R[(REST Binance<br/>fetch_positions)]
    O[(Open Orders<br/>fetch_open_orders)]
    P[POSTradeManager<br/>posición local]
    G[Guardian<br/>HARD SL + SL/TK]
    S[Situación detectada]

    subgraph Decision
        A[Cantidad recibida] --> Q{cantidad > 0?}
        Q -- yes --> B[Revisar HARD SL adjunto]
        B -- adjunto OK --> C[Persistir amount + OPEN]
        B -- adjunto falló/ambiguo --> D[Emergency Market Close]
        D --> E[HALT + EXIT_STUCK]
        Q -- no/zero --> F[Reconciliar via fetch_positions]
        F --> Z{coincidencia con exchange?}
        Z -- exposición real --> B
        Z -- plana --> C0[Persistir amount=None + HALT]
        C0 --> E
    end

    subgraph Persistence
        C --> PG[(persistir estado)]
        PG -- falla --> PF[close_failed=True]
        PF --> PH[HALT + INTEGRITY_LOCK]
    end

    S --> Decision
    R --> Decision
    O --> Decision
    P --> G
