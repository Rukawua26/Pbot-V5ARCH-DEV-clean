# =============================================================================
# SNIPER AI - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control. The .gitignore already excludes it.
#
# Security model:
#   - PAPER mode is the DEFAULT and safest for testing
#   - REAL mode requires BOTH PAPER_MODE=false AND ALLOW_REAL_TRADING=true
#   - For production, prefer system env vars over .env file
# =============================================================================

# --- BINANCE CREDENTIALS ---
# Generate API keys from Binance Futures dashboard.
# IP-restrict to your server IP. Enable only Futures permissions.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# --- OPERATION MODE ---
# PAPER_MODE=true  -> simulated trading (default, safest)
# PAPER_MODE=false + ALLOW_REAL_TRADING=true -> REAL trading with capital
PAPER_MODE=true
ALLOW_REAL_TRADING=false
USE_TESTNET=false
EXECUTION_BACKEND=live

# --- RUNTIME STATE PATHS ---
# Keep mutable state outside the code checkout in production when possible.
SNIPER_DB_PATH=tools/sniper_brain.db
WATCHDOG_HEARTBEAT_PATH=/dev/shm/sniper_ai_heartbeat.json

# --- TELEGRAM NOTIFICATIONS ---
# Create a bot via @BotFather and get the chat ID.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# Optional: comma-separated Telegram user IDs allowed to send commands in the configured chat.
# TELEGRAM_ADMIN_IDS=

# --- RISK PARAMETERS (REAL mode) ---
# These are validated on startup when PAPER_MODE=false.
MAX_OPEN_TRADES=1
RISK_PER_TRADE_PERCENT=0.5
MAX_RISK_USD=5.0
MAX_MARGIN_PERCENT=5.0
MIN_NOTIONAL_VALUE=5.0

# --- TRADING PARAMETERS ---
SHOCK_MIN_DIST_PCT=0.20
SMART_EXIT_THRESHOLD_REAL=0.75
SMART_EXIT_THRESHOLD_SHADOW=0.50
MAX_ENTRY_SL_PCT=3.00
STOP_LOSS_ATR_MODIFIER=2.0

# --- PHASE 12: RISK INTELLIGENCE ---
# All default to false for safety. Enable one at a time after validation.
MTF_FILTER_ENABLED=false
CORRELATION_RISK_ENABLED=false
REGIME_TUNING_ENABLED=false
CVD_FILTER_ENABLED=false
OI_FILTER_ENABLED=true
MARKET_BREADTH_FEAR_THRESHOLD=0.70

# --- SHADOW LIVE SIMULATION ---
SHADOW_SIM_LATENCY_MIN_MS=200
SHADOW_SIM_LATENCY_MAX_MS=500
SHADOW_SIM_REJECT_RATE=0.03
SHADOW_SIM_PARTIAL_FILL_RATE=0.25
SHADOW_SIM_PARTIAL_COMPLETE_RATE=0.50
SHADOW_SIM_PRICE_OUT_OF_RANGE_RATE=0.05
SHADOW_SIM_MIN_PARTIAL_RATIO=0.30

# --- RUNTIME SAFETY TIMERS ---
PARTIAL_FILL_TIMEOUT_SECONDS=300
PENDING_SEND_STALE_SECONDS=30
GLOBAL_ENTRY_COOLDOWN_SECONDS=300
HARD_SL_ATTACH_MAX_RETRIES=3

# --- DASHBOARD API ---
# Required when the dashboard API is enabled.
# SNIPER_API_KEY=change-me-at-least-16-chars
SNIPER_DASHBOARD_ORIGINS=http://127.0.0.1:8000

# --- PAPER/SHADOW OBSERVATION FLAGS ---
# Keep these disabled by default. Enable only in PAPER or SHADOW to collect evidence.
FVG_TRACKER_ENABLED=false
FVG_MIN_GAP_PCT=0.1
FVG_SCAN_INTERVAL=300
FVG_ALERT_TELEGRAM=true
FVG_ALERT_THROTTLE_SEC=3600
FVG_MAX_CANDLES_SCAN=200
FVG_MAX_SYMBOLS_PER_CYCLE=20
FVG_EXPIRATION_BARS=48

GLOBAL_MARKET_PROVIDER_ENABLED=false
GLOBAL_MARKET_CACHE_TTL=300
GLOBAL_MARKET_USE_MCP=false
GLOBAL_FEAR_GREED_FILTER_ENABLED=true
GLOBAL_BTC_DOM_FILTER_ENABLED=true
GLOBAL_FEAR_VETO_THRESHOLD=20
GLOBAL_BTC_DOM_BOOST_THRESHOLD=65.0

SIGNAL_AGENT_OVERRIDE_ENABLED=true
SIGNAL_AGENT_OVERRIDE_THRESHOLD=15.0
EXIT_RANGE_BREAKEVEN_PULLBACK_MULT=2.0
EXIT_RANGE_ACTIVATION_MULT=1.5

SHADOW_VALIDATION_ENABLED=false
SHADOW_VALIDATION_CAMPAIGN=shadow_macro_fvg_consensus_v1

# --- OPT-IN BINANCE TESTNET E2E ---
# These tests send live orders to Binance Futures Testnet only.
# They are skipped unless RUN_BINANCE_TESTNET_E2E=true.
RUN_BINANCE_TESTNET_E2E=false
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_SYMBOL=BTC/USDT
BINANCE_TESTNET_ORDER_AMOUNT=0.001

# --- GITHUB PROJECTS KANBAN ---
# Token Classic con scope 'project' (read/write en GitHub Projects v2).
# Tablero creado: https://github.com/users/Rukawua26/projects/1
# GITHUB_TOKEN=
GITHUB_PROJECT_ID=PVT_kwHOBsmMqc4BZ-nr
GITHUB_PROJECT_OWNER=Rukawua26
GITHUB_PROJECT_NUMBER=1
# GITHUB_REPOSITORY=Rukawua26/Pbot-V5ARCH-DEV
